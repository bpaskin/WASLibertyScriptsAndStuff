<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ibm.example.security</groupId>
    <artifactId>Vault</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>WAS HashiCorp Vault Password</name>
    <description>
        Pluggable custom password encryption for traditional WebSphere Application Server (tWAS)
        that retrieves secrets from HashiCorp Vault using AppRole authentication.
        Passwords enclosed in brackets (e.g. [mydbpassword]) are resolved against
        the Vault path secret/data/WAScreds at runtime.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <dependencies>
        <!--
            tWAS runtime JARs installed from ~/Downloads into the local Maven
            repository via:
              mvn install:install-file \
                  -Dfile="${HOME}/Downloads/com.ibm.ws.runtime.jar" \
                  -DgroupId=com.ibm.websphere -DartifactId=com.ibm.ws.runtime \
                  -Dversion=9.0 -Dpackaging=jar -DgeneratePom=true
              mvn install:install-file \
                  -Dfile="${HOME}/Downloads/com.ibm.ws.prereq.jaxrs20.jar" \
                  -DgroupId=com.ibm.websphere -DartifactId=com.ibm.ws.prereq.jaxrs20 \
                  -Dversion=9.0 -Dpackaging=jar -DgeneratePom=true
            Both are "provided" — used only at compile time; tWAS supplies them at runtime.
        -->
        <dependency>
            <groupId>com.ibm.websphere</groupId>
            <artifactId>com.ibm.ws.runtime</artifactId>
            <version>9.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm.websphere</groupId>
            <artifactId>com.ibm.ws.prereq.jaxrs20</artifactId>
            <version>9.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Built-By>Brian S Paskin</Built-By>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
